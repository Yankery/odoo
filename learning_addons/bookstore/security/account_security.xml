<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Agent Group -->
    <record id="bookstore_group_user" model="res.groups">
        <field name="name">Agent</field>
        <field name="category_id" ref="base.module_category_management_bookstore"/>
    </record>

    <!-- Manager Group -->
    <record id="bookstore_group_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="base.module_category_management_bookstore"/>
        <field name="implied_ids" eval="[(4, ref('bookstore_group_user'))]"/>
    </record>

    <!-- Record Rules for Orders - Portal Users can only see their own orders -->
    <record id="bookstore_order_rule_portal" model="ir.rule">
        <field name="name">Portal User: Own Orders Only</field>
        <field name="model_id" ref="model_bookstore_order"/>
        <field name="domain_force">[('partner_id', '=', user.partner_id.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="perm_read">1</field>
        <field name="perm_write">0</field>
        <field name="perm_create">1</field>
        <field name="perm_unlink">0</field>
    </record>

    <!-- Record Rules for Orders - Internal Users see all orders -->
    <record id="bookstore_order_rule_user" model="ir.rule">
        <field name="name">Internal User: All Orders</field>
        <field name="model_id" ref="model_bookstore_order"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('bookstore_group_user'))]"/>
        <field name="perm_read">1</field>
        <field name="perm_write">1</field>
        <field name="perm_create">1</field>
        <field name="perm_unlink">0</field>
    </record>

    <!-- Record Rules for Orders - Managers see all orders and can delete -->
    <record id="bookstore_order_rule_manager" model="ir.rule">
        <field name="name">Manager: All Orders Full Access</field>
        <field name="model_id" ref="model_bookstore_order"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('bookstore_group_manager'))]"/>
        <field name="perm_read">1</field>
        <field name="perm_write">1</field>
        <field name="perm_create">1</field>
        <field name="perm_unlink">1</field>
    </record>

    <!-- Record Rules for Books - Portal Users can see all available books -->
    <record id="bookstore_book_rule_portal" model="ir.rule">
        <field name="name">Portal User: All Books Read Only</field>
        <field name="model_id" ref="model_bookstore_book"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="perm_read">1</field>
        <field name="perm_write">0</field>
        <field name="perm_create">0</field>
        <field name="perm_unlink">0</field>
    </record>
</odoo>