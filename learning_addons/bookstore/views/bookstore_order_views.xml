<odoo>
    <!-- Tree View -->
    <record id="view_bookstore_order_tree" model="ir.ui.view">
        <field name="name">bookstore.order.tree</field>
        <field name="model">bookstore.order</field>
        <field name="arch" type="xml">
            <tree string="Book Orders">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="book_id"/>
                <field name="quantity"/>
                <field name="total_price"/>
                <field name="order_date"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'confirmed'"
                       decoration-primary="state == 'processing'"
                       decoration-success="state == 'delivered'"
                       decoration-danger="state == 'cancelled'"/>
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_bookstore_order_form" model="ir.ui.view">
        <field name="name">bookstore.order.form</field>
        <field name="model">bookstore.order</field>
        <field name="arch" type="xml">
            <form string="Book Order">
                <header>
                    <button name="action_confirm" string="Confirm" type="object"
                            class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_process" string="Process" type="object"
                            class="oe_highlight" invisible="state != 'confirmed'"/>
                    <button name="action_deliver" string="Deliver" type="object"
                            class="oe_highlight" invisible="state != 'processing'"/>
                    <button name="action_cancel" string="Cancel" type="object"
                            invisible="state not in ['draft', 'confirmed']"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,confirmed,processing,delivered"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="book_id"/>
                            <field name="order_date"/>
                        </group>
                        <group>
                            <field name="quantity"/>
                            <field name="unit_price"/>
                            <field name="total_price"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Notes">
                            <field name="notes" placeholder="Add any notes here..."/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_bookstore_order_search" model="ir.ui.view">
        <field name="name">bookstore.order.search</field>
        <field name="model">bookstore.order</field>
        <field name="arch" type="xml">
            <search string="Book Orders">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="book_id"/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Confirmed" name="confirmed" domain="[('state', '=', 'confirmed')]"/>
                <filter string="Processing" name="processing" domain="[('state', '=', 'processing')]"/>
                <filter string="Delivered" name="delivered" domain="[('state', '=', 'delivered')]"/>
                <group expand="0" string="Group By">
                    <filter string="Customer" name="group_partner" context="{'group_by': 'partner_id'}"/>
                    <filter string="Book" name="group_book" context="{'group_by': 'book_id'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_bookstore_order" model="ir.actions.act_window">
        <field name="name">Book Orders</field>
        <field name="res_model">bookstore.order</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first book order
            </p>
        </field>
    </record>
</odoo>