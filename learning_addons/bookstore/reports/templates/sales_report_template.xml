<odoo>
    <template id="sales_report_template">
        <t t-name="bookstore.sales_report_template">
            <t t-call="web.external_layout">
                <div class="page">
                    <h2>Sales Report - Last 30 Days</h2>
                    <t t-set="lines" t-value="docs.filtered(lambda l: l.product_id.bookstore_book_id).sorted('order_id.date_order', reverse=True)"/>
                    <table class="table table-sm">
                        <thead><tr><th>Date</th><th>Book</th><th>Qty</th><th>Amount</th></tr></thead>
                        <t t-foreach="lines" t-as="line">
                            <tr>
                                <td><span t-field="line.order_id.date_order" t-options='{"widget":"date"}'/></td>
                                <td><span t-esc="line.product_id.name"/></td>
                                <td><span t-field="line.product_uom_qty"/></td>
                                <td><span t-field="line.price_total" t-options='{"widget": "monetary"}'/></td>
                            </tr>
                        </t>
                    </table>
                </div>
            </t>
        </t>
    </template>
</odoo>